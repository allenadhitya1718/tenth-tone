{
  "expo": {
    "name": "FLYP",
    "slug": "flyp",
    "scheme": "flyp",
    "version": "2.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/9a8329f5-b423-4671-8f3d-fd563c113f34",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#000421",
    "ios": {
      "bundleIdentifier": "com.flyp.social",
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "CFBundleLocalizations": [
          "ar",
          "en",
          "zh",
          "hi",
          "ur",
          "fr",
          "es",
          "tr",
          "id"
        ],
        "UIBackgroundModes": [
          "audio",
          "voip"
        ],
        "NSCameraUsageDescription": "FLYP uses the camera to record videos and go live.",
        "NSMicrophoneUsageDescription": "FLYP uses the microphone for videos, voice messages, live audio and calls.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryAddUsageDescription": "FLYP saves videos and photos you choose to your library."
      },
      "entitlements": {
        "com.apple.developer.usernotifications.time-sensitive": true
      },
      "associatedDomains": [
        "applinks:flyp-sa.com",
        "applinks:www.flyp-sa.com"
      ]
    },
    "android": {
      "package": "com.flyp.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "flyp-sa.com",
              "pathPrefix": "/live/"
            },
            {
              "scheme": "https",
              "host": "flyp-sa.com",
              "pathPrefix": "/v/"
            },
            {
              "scheme": "https",
              "host": "flyp-sa.com",
              "pathPrefix": "/u/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "www.flyp-sa.com",
              "pathPrefix": "/live/"
            },
            {
              "scheme": "https",
              "host": "www.flyp-sa.com",
              "pathPrefix": "/v/"
            },
            {
              "scheme": "https",
              "host": "www.flyp-sa.com",
              "pathPrefix": "/u/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "adaptiveIcon": {
        "backgroundColor": "#000421",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.CAMERA",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_FULL_SCREEN_INTENT",
        "android.permission.VIBRATE"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/withRtlSupport",
      "./plugins/withMinSdk26",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-dot.png",
          "imageWidth": 200,
          "backgroundColor": "#000421",
          "dark": {
            "backgroundColor": "#000421"
          }
        }
      ],
      "expo-font",
      "expo-apple-authentication",
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      "expo-video",
      "expo-image",
      "expo-sharing",
      "expo-audio",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "FLYP uses your location to show you on the friends map and to tag places on posts, only when you choose to share it."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "FLYP needs access to your photos to post them and to set your profile picture.",
          "cameraPermission": "FLYP uses the camera to take photos."
        }
      ],
      [
        "expo-notifications",
        {
          "enableBackgroundRemoteNotifications": true,
          "sounds": [
            "./assets/sounds/flyp_ring.wav",
            "./assets/sounds/flyp_message.wav"
          ]
        }
      ],
      "expo-asset",
      [
        "react-native-notify-kit",
        {
          "android": {
            "foregroundService": {
              "types": [
                "microphone",
                "mediaPlayback"
              ]
            }
          }
        }
      ],
      "expo-iap"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "supportsRTL": true,
      "eas": {
        "projectId": "9a8329f5-b423-4671-8f3d-fd563c113f34"
      }
    },
    "owner": "allen18"
  }
}

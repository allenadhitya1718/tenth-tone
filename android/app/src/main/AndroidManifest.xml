<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep links: verified Android App Links (https://flyp-sa.com/...).
                 Requires .well-known/assetlinks.json served from the domain root
                 with this app's real signing-certificate SHA-256 fingerprint. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="flyp-sa.com" android:pathPrefix="/v/" />
                <data android:scheme="https" android:host="flyp-sa.com" android:pathPrefix="/u/" />
                <data android:scheme="https" android:host="flyp-sa.com" android:pathPrefix="/live/" />
                <data android:scheme="https" android:host="www.flyp-sa.com" android:pathPrefix="/v/" />
                <data android:scheme="https" android:host="www.flyp-sa.com" android:pathPrefix="/u/" />
                <data android:scheme="https" android:host="www.flyp-sa.com" android:pathPrefix="/live/" />
            </intent-filter>

            <!-- Custom-scheme fallback (flyp://v/<id>) — works without
                 domain verification, used for in-app/OAuth style returns. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="flyp" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
        <!-- Holds the process open for the duration of a call and puts it in
             the shade with a Hang up button. Not exported: only this app
             starts it. stopWithTask so a swiped-away app does not leave a
             call notification behind with nothing running under it. -->
        <service
            android:name=".CallForegroundService"
            android:exported="false"
            android:stopWithTask="true"
            android:foregroundServiceType="microphone" />

    </application>

    <!-- Permissions -->
    <!--
      These are declared here rather than injected at build time. The CI
      workflow used to sed them in, which meant any APK built locally with
      android/build_apk.bat shipped with INTERNET alone: the camera could
      never be granted, and recording failed with "permission denied" no
      matter what the person tapped in the system dialog. The workflow skips
      its patch when RECORD_AUDIO is already present, so this stays correct
      for CI builds too.
    -->

    <!-- A call keeps running when FLYP is not the app on screen. Android
         only allows that for a foreground service, and from 14 each one must
         name the type it is and hold the matching permission. MICROPHONE is
         what a call actually holds; phoneCall would need a self-managed
         ConnectionService the app does not have. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Recording and live streaming -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Agora switches the audio route (earpiece/speaker) during a call -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Map, friend locations, ghost mode -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Picking a clip or photo from the gallery needs no media permission:
         the page's <input type="file"> opens the system picker, which hands
         back only the file the person chose. READ_MEDIA_IMAGES and
         READ_MEDIA_VIDEO used to be declared here and no code ever used them.
         Google Play allows those two only to apps that need broad access to
         the whole library (a gallery, an editor); anyone else must use the
         picker, and a Play submission holding them has to justify them in a
         declaration it would fail. The legacy permission stays, capped at
         Android 12, which that policy does not cover. -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />


    <!-- A device without a camera can still use the rest of the app, so this
         must not become an install-time filter on the Play Store. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
</manifest>

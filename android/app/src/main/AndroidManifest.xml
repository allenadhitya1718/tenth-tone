<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep links: verified Android App Links (https://flyp-sa.com/...).
                 Requires .well-known/assetlinks.json served from the domain root
                 with this app's real signing-certificate SHA-256 fingerprint. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="flyp-sa.com" android:pathPrefix="/v/" />
                <data android:scheme="https" android:host="flyp-sa.com" android:pathPrefix="/u/" />
                <data android:scheme="https" android:host="flyp-sa.com" android:pathPrefix="/live/" />
                <data android:scheme="https" android:host="www.flyp-sa.com" android:pathPrefix="/v/" />
                <data android:scheme="https" android:host="www.flyp-sa.com" android:pathPrefix="/u/" />
                <data android:scheme="https" android:host="www.flyp-sa.com" android:pathPrefix="/live/" />
            </intent-filter>

            <!-- Custom-scheme fallback (flyp://v/<id>) — works without
                 domain verification, used for in-app/OAuth style returns. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="flyp" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->
    <!--
      These are declared here rather than injected at build time. The CI
      workflow used to sed them in, which meant any APK built locally with
      android/build_apk.bat shipped with INTERNET alone: the camera could
      never be granted, and recording failed with "permission denied" no
      matter what the person tapped in the system dialog. The workflow skips
      its patch when RECORD_AUDIO is already present, so this stays correct
      for CI builds too.
    -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Recording and live streaming -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Agora switches the audio route (earpiece/speaker) during a call -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Map, friend locations, ghost mode -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Picking a clip or photo from the gallery. Android 13 split the old
         single storage permission per media type; the legacy one is capped so
         it is not requested on versions that no longer use it. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Android 13+ requires this to be requested before notifications show -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- A device without a camera can still use the rest of the app, so this
         must not become an install-time filter on the Play Store. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
</manifest>

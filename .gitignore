# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.log

# Node
node_modules/
.env
.env.local

# Flutter
flutter/.dart_tool/
flutter/.flutter-plugins
flutter/.flutter-plugins-dependencies
flutter/.packages
flutter/.pub-cache/
flutter/.pub/
flutter/build/
flutter/.metadata
flutter/ios/Pods/
flutter/ios/.symlinks/
flutter/ios/Flutter/Flutter.framework
flutter/ios/Flutter/App.framework
flutter/ios/Flutter/Generated.xcconfig
flutter/ios/Flutter/flutter_export_environment.sh
flutter/ios/Runner.xcworkspace/xcuserdata/
flutter/android/.gradle/
flutter/android/build/
flutter/android/local.properties
flutter/android/app/debug
flutter/android/app/profile
flutter/android/app/release

# iOS code-signing — NEVER commit
*.p12
*.p8
*.mobileprovision
*.cer

# Web build artifacts (we DO commit flutter/build_web/ for Vercel deploy though)
web/dist/

# Third-party API key, must never reach the repo
.pexels-key

# Capacitor Android build output and machine-specific files
android/local.properties
android/.gradle/
android/build/
android/app/build/
android/app/src/main/assets/public/
out/
web/BUILD_INFO.txt

# R2 migration credentials. Holds the Supabase service_role key, which
# bypasses every RLS policy in the database, alongside the R2 secret.
# tools/copy_media_to_r2.py reads it; delete the file once the copy is done.
*.env
r2-migrate.env
# Notepad appends .txt silently, which slips past the *.env rule above.
*.env.txt
r2_url_rewrite.sql

# Python bytecode from tools/ — committed by accident once already.
__pycache__/
*.pyc

# Agent worktrees live inside the repo and must never be committed —
# each is a full second checkout of this same repository.
.claude/worktrees/

# Stray editor backup.
*.old-backup

# Copy to /opt/flyp-live/.env on the server and fill in. install.sh creates
# the LiveKit key and secret itself if they are empty. This file holds
# secrets: it stays on the server (chmod 600), never in git, never in chat.

# The address the app connects to. Add a DNS record in Cloudflare:
# A  live  <server public IP>   (DNS only, grey cloud)
LIVE_DOMAIN=live.flyp-sa.com

# Filled in by install.sh if empty. Copy them into Supabase secrets
# (LIVEKIT_API_KEY, LIVEKIT_API_SECRET, LIVEKIT_URL=wss://<LIVE_DOMAIN>).
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

SUPABASE_URL=https://vfkwipvinmnybilcrdzr.supabase.co

# Recording storage: FLYP's own bucket. Use a NEW R2 token scoped to
# flyp-app-media only (Object Read & Write), not the old app's key.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=flyp-app-media

# Better Stack heartbeat URL (a "heartbeat" monitor). The watchdog pings it
# every minute while everything is healthy; if the pings stop, Better Stack
# alerts you. Leave empty until Better Stack is set up.
BETTERSTACK_HEARTBEAT_URL=

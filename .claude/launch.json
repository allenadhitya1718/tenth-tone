{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "mobile-web",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "export PATH=$HOME/.nvm/versions/node/v24.22.0/bin:$PATH && cd mobile && npx expo start --web --port 8081"],
      "port": 8081
    },
    {
      "name": "admin-v2",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "5500", "--bind", "127.0.0.1", "--directory", "web"],
      "port": 5500
    },
    {
      "name": "admin-dist",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "5501", "--bind", "127.0.0.1", "--directory", "admin-dist"],
      "port": 5501
    }
  ]
}
